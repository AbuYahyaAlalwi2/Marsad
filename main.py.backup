"""
CYBERGUARD OS — النظام الرئيسي للداشبورد
"""
import streamlit as st
import time
import os
from db import init_db, get_recent_events, get_memory_size_gb, get_database_stats, insert_conversation, get_conversation_history
from core.brain import brain
from core.memory import memory
from chat.interface import chat
from agents.hierarchy import hierarchy
from agents.parasite import parasite_swarm
from merge.omni_merger import merger
from collect.multi_platform import collector
from collect.datasets import dataset_collector
from providers.llm_providers import llm_providers
from providers.code_providers import code_providers
from plugins.loader import plugin_loader
from keep_alive import start_keep_alive, stop_keep_alive
from config import KEEP_ALIVE_INTERVAL, DATASET_PLATFORMS, API_PROVIDERS, SOURCE_PLATFORMS

# تهيئة النظام
init_db()
memory.start_monitoring()
hierarchy.initialize()
plugin_loader.load_all()

# بدء نظام مانع الخمول
if os.environ.get("CG_ENABLE_KEEP_ALIVE", "true").lower() == "true":
    start_keep_alive()

# إعداد Streamlit
st.set_page_config(
    page_title="CYBERGUARD OS",
    page_icon="🛡️",
    layout="wide",
    initial_sidebar_state="expanded"
)

# عنوان رئيسي
st.title("🛡️ CYBERGUARD OS — النظام الذكي للأمن السيبراني")
st.markdown("---")

# Sidebar
with st.sidebar:
    st.header("🎛️ لوحة التحكم")
    
    # إحصائيات سريعة
    st.subheader("📊 إحصائيات النظام")
    db_stats = get_database_stats()
    
    col1, col2 = st.columns(2)
    with col1:
        st.metric("قاعدة البيانات", f"{db_stats.get('db_size_mb', 0):.2f} MB")
        st.metric("الذاكرة", f"{get_memory_size_gb():.2f} GB")
    with col2:
        st.metric("المحادثات", db_stats.get("conversations_count", 0))
        st.metric("البيانات", db_stats.get("datasets_count", 0))
    
    # أوامر سريعة
    st.subheader("🔧 أوامر سريعة")
    command = st.text_input("أدخل أمر:", key="sidebar_command")
    if st.button("تنفيذ", key="sidebar_execute") and command:
        result = chat.handle(command)
        st.json(result)
        # حفظ في قاعدة البيانات
        if result.get("status") == "success":
            insert_conversation(
                session_id="sidebar",
                user_input=command,
                response=str(result),
                provider="chat",
                model="default"
            )

# Tabs الرئيسية
tabs = st.tabs([
    "💬 الدردشة", "🕸️ الوكلاء", "🔗 الدمج", "🔍 الجمع", 
    "📚 البيانات", "🤖 API", "💾 الذاكرة", "📋 الأحداث"
])

# --- Tab 1: الدردشة ---
with tabs[0]:
    st.header("💬 الدردشة الذكية")
    
    # عرض تاريخ المحادثات
    st.subheader("📜 تاريخ المحادثات")
    conversations = get_conversation_history("main", limit=10)
    for conv in conversations:
        with st.expander(f"{conv['created_at']} - {conv['user_input'][:50]}..."):
            st.text(f"Input: {conv['user_input']}")
            st.text(f"Response: {conv['response'][:200]}...")
    
    # واجهة الدردشة
    user_input = st.text_input("أدخل رسالتك:", key="chat_input")
    if st.button("إرسال", key="chat_send") and user_input:
        with st.spinner("جاري المعالجة..."):
            result = chat.handle(user_input)
            
        # عرض النتيجة
        if result.get("status") == "success":
            st.success("✅ تم التنفيذ بنجاح")
            st.json(result)
            
            # حفظ في قاعدة البيانات
            insert_conversation(
                session_id="main",
                user_input=user_input,
                response=str(result),
                provider="chat",
                model="default"
            )
        else:
            st.error(f"❌ خطأ: {result.get('reason', 'Unknown')}")
    
    # إحصائيات الدردشة
    st.subheader("📊 إحصائيات الدردشة")
    st.json(chat.get_stats())

# --- Tab 2: الوكلاء ---
with tabs[1]:
    st.header("🕸️ إدارة الوكلاء")
    
    col1, col2 = st.columns(2)
    with col1:
        st.subheader("📊 هيكل الوكلاء")
        if st.button("عرض الهيكلة"):
            result = hierarchy.expand(hierarchy.root_id, target_agents=1000)
            st.json(result)
        st.json(hierarchy.get_stats())
    
    with col2:
        st.subheader("🎯 نشر الوكلاء")
        if st.button("نشر 1000 وكيل"):
            parasites = parasite_swarm.deploy("github", 1000)
            st.success(f"✅ تم نشر {len(parasites)} وكيل")
        
        st.subheader("📈 إحصائيات")
        from db import count_agents_by_level
        for level in range(1, 5):
            count = count_agents_by_level(level)
            st.metric(f"مستوى {level}", count)

# --- Tab 3: الدمج ---
with tabs[2]:
    st.header("🔗 دمج النماذج")
    
    st.subheader("📋 خطة الدمج")
    st.json(merger.get_merge_plan())
    
    if st.button("بدء الدمج"):
        with st.spinner("جاري دمج النماذج..."):
            result = merger.merge_all()
        st.json(result)

# --- Tab 4: الجمع ---
with tabs[3]:
    st.header("🔍 جمع البيانات")
    
    # اختيار المنصة
    platform_options = list(DATASET_PLATFORMS.keys())
    selected_platform = st.selectbox("اختر المنصة:", platform_options)
    
    query = st.text_input("استعلام البحث:", "security vulnerability")
    limit = st.slider("عدد النتائج:", 1, 50, 10)
    
    if st.button("بدء الجمع"):
        with st.spinner(f"جاري الجمع من {selected_platform}..."):
            results = collector.collect_all(query, limit)
        st.json(results)
    
    # إحصائيات المنصات
    st.subheader("📊 المنصات المدعومة")
    for platform_name, platform_info in SOURCE_PLATFORMS.items():
        weight = platform_info.get("weight", 0)
        priority = platform_info.get("priority", 0)
        st.write(f"- **{platform_name}**: وزن={weight}, أولوية={priority}")

# --- Tab 5: البيانات ---
with tabs[4]:
    st.header("📚 إدارة البيانات")
    
    st.subheader("🔽 جمع البيانات")
    ds_query = st.text_input("بحث:", "code security", key="ds_query")
    if st.button("جمع البيانات"):
        with st.spinner("جاري الجمع..."):
            results = dataset_collector.collect_all(ds_query)
        st.json(results)
    
    if st.button("تنزيل المعلقة"):
        result = dataset_collector.download_pending()
        st.json(result)
    
    # إحصائيات البيانات
    st.subheader("📊 إحصائيات البيانات")
    ds_stats = dataset_collector.get_dataset_stats()
    st.json(ds_stats)

# --- Tab 6: API ---
with tabs[5]:
    st.header("🤖 مزودي API")
    
    # قائمة المزودين
    st.subheader("📋 مزودي LLM")
    llm_providers_list = llm_providers.list_available_providers()
    st.json(llm_providers_list)
    
    st.subheader("📋 مزودي الكود")
    code_providers_list = code_providers.list_available_providers()
    st.json(code_providers_list)
    
    # اختبار توليد نص
    st.subheader("✍️ توليد نص")
    llm_prompt = st.text_area("النص:")
    if st.button("توليد"):
        with st.spinner("جاري التوليد..."):
            result = llm_providers.generate(llm_prompt)
        st.json(result)
        
        # حفظ في قاعدة البيانات
        if result.get("status") == "success":
            insert_conversation(
                session_id="llm",
                user_input=llm_prompt,
                response=result.get("text", ""),
                provider=result.get("provider", "unknown"),
                model=result.get("model", "unknown")
            )
    
    # اختبار توليد كود
    st.subheader("💻 توليد كود")
    code_prompt = st.text_area("الوصف:", key="code_prompt")
    code_language = st.selectbox("اللغة:", ["python", "javascript", "bash", "java"])
    if st.button("توليد الكود"):
        with st.spinner("جاري التوليد..."):
            result = code_providers.generate_code(code_prompt, language=code_language)
        st.json(result)
        
        # حفظ في قاعدة البيانات
        if result.get("status") == "success":
            insert_conversation(
                session_id="code",
                user_input=code_prompt,
                response=result.get("code", ""),
                provider=result.get("provider", "unknown"),
                model=result.get("model", "unknown")
            )

# --- Tab 7: الذاكرة ---
with tabs[6]:
    st.header("💾 الذاكرة المتحكة")
    
    current_gb = get_memory_size_gb()
    st.metric("حجم الذاكرة", f"{current_gb:.2f} GB")
    
    # عرض التقدم
    progress = min(1.0, current_gb / 10.0)
    st.progress(progress)
    st.caption(f"سعة الذاكرة: {progress * 100:.1f}% من 10 GB")
    
    if st.button("المعالجة التلقائية"):
        memory._auto_process()
        st.success("✅ تم بدء المعالجة التلقائية")
    
    # إحصائيات الذاكرة
    db_stats = get_database_stats()
    st.subheader("📊 إحصائيات قاعدة البيانات")
    st.json(db_stats)

# --- Tab 8: الأحداث ---
with tabs[7]:
    st.header("📋 سجل الأحداث")
    
    limit = st.slider("عدد الأحداث:", 10, 100, 50, key="events_limit")
    events = get_recent_events(limit)
    
    for event in events:
        with st.expander(f"{event['channel']} - {event['created_at']}"):
            st.json(event)

# Footer
st.markdown("---")
st.markdown("""
<div style='text-align: center; color: #666;'>
    <p>CYBERGUARD OS - النظام الذكي للأمن السيبراني</p>
    <p>جميع الحقوق محفوظة</p>
</div>
""", unsafe_allow_html=True)
