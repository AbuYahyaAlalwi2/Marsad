# ============================================================
# CYBERGUARD Worker Node - Universal Docker Image
# Deploys to: Fly.io, Railway, Render, Cloudflare, Koyeb, ...
# ============================================================
FROM python:3.11-slim

WORKDIR /app

# Install minimal system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps
RUN pip install --no-cache-dir \
    requests \
    psutil \
    pycryptodome \
    huey \
    flask

# Copy worker files
COPY worker_node.py /app/
COPY db.py /app/ 2>/dev/null || true
COPY config.py /app/ 2>/dev/null || true

# Environment defaults
ENV CG_CLOUD_PROVIDER=container
ENV CG_WORKER_CAPACITY=10000
ENV CG_CONTROL_PLANE_URL=https://marsad-dashboard.onrender.com
ENV PYTHONUNBUFFERED=1

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import os, time; print(int(time.time()))" || exit 1

CMD ["python", "worker_node.py"]
