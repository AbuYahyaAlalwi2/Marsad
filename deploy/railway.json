{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/Dockerfile.worker"
  },
  "deploy": {
    "startCommand": "python worker_node.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  },
  "environments": {
    "production": {
      "variables": {
        "CG_CONTROL_PLANE_URL": "https://marsad-dashboard.onrender.com",
        "CG_CLOUD_PROVIDER": "railway",
        "CG_WORKER_CAPACITY": "10000",
        "CG_REGION": "auto"
      }
    }
  }
}
